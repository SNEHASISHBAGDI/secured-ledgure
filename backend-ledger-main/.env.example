# MongoDB Replica Set URI (required for multi-document ACID transactions)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/bank-backend?retryWrites=true&w=majority

# JWT Secret Key for Authentication Cookies & Tokens
JWT_SECRET=replace-with-a-strong-random-secret

# Optional: Gmail OAuth2 Credentials for Email Notifications
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
REFRESH_TOKEN=your-google-oauth-refresh-token
EMAIL_USER=your-sender-email@gmail.com

# Optional: Explicit System Admin Secret Key required to call POST /api/transactions/system/initial-funds
# If left unset, the administrative initial-funds endpoint remains securely disabled.
SYSTEM_ADMIN_KEY=replace-with-a-secure-system-admin-key
